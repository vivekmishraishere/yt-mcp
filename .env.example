# yt-mcp settings. Copy to .env for local runs, or enter these in your host's environment-variable screen
# (Hostinger: Node.js app -> Environment variables). Never commit real values.

# ---------- required for remote (HTTP) mode ----------
# Long random secret. Clients send it as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret
# Public HTTPS address of this deployment (used in download / upload links and Host-header validation)
PUBLIC_BASE_URL=https://mcp.example.com

# ---------- optional ----------
# PORT is set automatically by Hostinger / most hosts. Default 3000.
# PORT=3000
# HOST=0.0.0.0
# Extra hostnames accepted in the Host header (comma separated). PUBLIC_BASE_URL's host is always allowed.
# ALLOWED_HOSTS=www.example.com
# Accept the token as /mcp?key=<token> for clients that can only take a URL (claude.ai custom connectors). 1/0
ALLOW_QUERY_TOKEN=1
# Requests per minute for the whole server (one tool call = 1-3 requests)
RATE_LIMIT_PER_MINUTE=600
# Images processed at the same time (raise on bigger servers)
MAX_CONCURRENT_JOBS=2
# Where uploads and results are stored, and how long they are kept
# STORAGE_DIR=/tmp/yt-mcp-files
FILE_TTL_HOURS=24
# Input limits
MAX_INPUT_MB=25
MAX_PIXELS=60000000
# Load images from http(s) URLs; block URLs pointing at localhost / private networks
ALLOW_URLS=1
BLOCK_PRIVATE_URLS=1
# libvips threads per image
SHARP_THREADS=2

# ---------- local (stdio) mode only ----------
# Folders the server may read (separate with ":" on macOS/Linux, ";" on Windows). Default: your home folder.
# ALLOWED_DIRS=~/Downloads:~/Desktop:~/Pictures
