{
  "name": "yt-mcp",
  "version": "1.0.0",
  "description": "Image MCP server: crop, LinkedIn profile rings, resize, upscale, HEIC/PNG/JPG/WebP/AVIF conversion, compression, filters, smart blur with face detection, text and watermarks. Remote (Streamable HTTP at /mcp) or local (stdio).",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/opentype.js": "^1.3.10",
    "dejavu-fonts-ttf": "^2.37.3",
    "exif-reader": "^2.0.3",
    "express": "^5.3.0",
    "heic-decode": "^2.1.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "private": true
}
